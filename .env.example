# GEMINI_API_KEY: Primary Google AI Studio API key injected at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AISTUDIO_API_KEYS: Optional comma-separated pool of Google AI Studio keys for automatic rotation on rate limits.
AISTUDIO_API_KEYS=""

# APINEX_API_KEY: Optional API key for https://apinex.bond (https://apinext.bond/v1) gateway.
APINEX_API_KEY=""

# BEATAPI_API_KEY: Optional API key for https://beatapi.io (https://api.beatapi.io/v1) gateway.
BEATAPI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
